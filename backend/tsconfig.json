{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/contracts": [
        "./libs/contracts/src/index.ts"
      ],
      "@app/contracts/*": [
        "./libs/contracts/src/*"
      ],
      "@app/database": [
        "./libs/database/src/index.ts"
      ],
      "@app/database/*": [
        "./libs/database/src/*"
      ],
      "@app/messaging": [
        "./libs/messaging/src/index.ts"
      ],
      "@app/messaging/*": [
        "./libs/messaging/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/api/tsconfig.app.json"
    },
    {
      "path": "./apps/moderation-worker/tsconfig.app.json"
    }
  ]
}
