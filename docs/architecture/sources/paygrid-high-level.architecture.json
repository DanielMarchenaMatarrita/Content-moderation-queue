    {
      "dot": "emerald",
      "title": "Processing semantics",
      "items": ["HTTP acceptance commits PaymentOrder and OutboxEvent in one PostgreSQL transaction.", "Order Processor consumes RabbitMQ with manual ACK and persists outcomes in PostgreSQL.", "Delivery is at-least-once; ProcessedMessage and attempt guards support duplicate handling."]
    },
    {
      "dot": "amber",
      "title": "Retries and failures",
      "items": ["Failed messages go through a 5-second retry queue, up to three retries.", "Invalid messages or exhausted retries route to the DLQ.", "The application does not consume or replay the DLQ."]
    },
    {
      "dot": "cyan",
      "title": "Deployment and observability",
      "items": ["Docker Compose runs frontend, API, processor, PostgreSQL, RabbitMQ, Loki, Alloy, and Grafana locally.", "Alloy reads only API and order-processor container logs, then pushes them to Loki for Grafana.", "Docker Hub images are referenced by Compose; image publication and remote deployment are not asserted."]
    }
