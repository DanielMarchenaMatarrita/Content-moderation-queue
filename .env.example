# Set non-empty passwords before deployment; values must be URL-safe for connection URI interpolation.
POSTGRES_DB=paygrid
POSTGRES_USER=paygrid
POSTGRES_PASSWORD=

RABBITMQ_USER=paygrid
RABBITMQ_PASSWORD=
RABBITMQ_MANAGEMENT_PORT=15672

# Local Grafana only. Set a non-empty password before running Docker Compose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

PAYGRID_BACKEND_IMAGE=danieleng96/paygrid-backend:1.0.0
PAYGRID_FRONTEND_IMAGE=danieleng96/paygrid-frontend:1.0.0
